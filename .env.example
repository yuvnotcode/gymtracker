# Copy to .env for local Docker use and replace each value before starting.
# Replace DOMAIN too if you use the optional Caddy server profile.
DOMAIN=app.example.com
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
APP_REGISTRATION_CODE=replace-with-a-private-beta-invite-code
# Optional. Add a Google OAuth Web client ID to enable Google sign-in.
GOOGLE_CLIENT_ID=
